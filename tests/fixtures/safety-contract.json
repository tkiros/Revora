{
  "forbiddenClaims": [
    {
      "label": "diagnosis",
      "pattern": "\\bdiagnos(e|es|ing|is)\\b",
      "example": "Revora diagnoses whether you have prediabetes."
    },
    {
      "label": "treatment",
      "pattern": "\\btreat(s|ed|ing)?\\b",
      "example": "Revora treats prediabetes through meal advice."
    },
    {
      "label": "prevention",
      "pattern": "\\bprevent(s|ed|ing|ion)?\\b",
      "example": "This meal plan prevents diabetes."
    },
    {
      "label": "cure",
      "pattern": "\\bcure(s|d|ing)?\\b",
      "example": "Revora cures prediabetes."
    },
    {
      "label": "reversal",
      "pattern": "\\brevers(e|es|ing|al)\\b",
      "example": "Revora helps reverse prediabetes."
    },
    {
      "label": "fda approval",
      "pattern": "\\bFDA\\b.{0,25}\\b(approved|approval|cleared|clearance)\\b",
      "example": "FDA approved guidance for prediabetes."
    },
    {
      "label": "unsupported clinical proof",
      "pattern": "\\b(clinically proven|clinically validated|doctor recommended)\\b",
      "example": "Clinically proven to lower your A1C."
    }
  ],
  "forbiddenPredictions": [
    {
      "label": "future a1c",
      "pattern": "\\bA1C\\b.{0,40}\\b(will|going to|drop to|fall to|rise to)\\b",
      "example": "Your A1C will drop to 5.8% if you keep eating this way."
    },
    {
      "label": "glucose curve",
      "pattern": "\\bglucose\\b.{0,40}\\bcurve\\b",
      "example": "This meal predicts your glucose curve for the next two hours."
    },
    {
      "label": "exact glucose spike",
      "pattern": "\\bspike(?:s|d)?\\b.{0,20}\\b\\d+(?:\\.\\d+)?\\s*mg\\/dL\\b",
      "example": "This meal will spike your glucose by 32 mg/dL."
    },
    {
      "label": "exact gi",
      "pattern": "\\bGI\\s*(?:of|=)?\\s*\\d+\\b",
      "example": "This meal has a GI of 68."
    },
    {
      "label": "exact gl",
      "pattern": "\\bGL\\s*(?:of|=)?\\s*\\d+\\b",
      "example": "This meal has a GL of 22."
    }
  ],
  "a1cRoutes": {
    "requiredRouteIds": [
      "below_prediabetes_range",
      "prediabetes_57_59",
      "prediabetes_60_62",
      "prediabetes_63_64",
      "diabetes_range_out_of_scope"
    ]
  },
  "qualitativeOnly": {
    "forbiddenPatterns": [
      {
        "label": "exact mg/dL",
        "pattern": "\\b\\d+(?:\\.\\d+)?\\s*mg\\/dL\\b"
      },
      {
        "label": "exact gi",
        "pattern": "\\bGI\\s*(?:of|=)?\\s*\\d+\\b"
      },
      {
        "label": "exact gl",
        "pattern": "\\bGL\\s*(?:of|=)?\\s*\\d+\\b"
      },
      {
        "label": "exact spike phrasing",
        "pattern": "\\bspike(?:s|d)?\\b.{0,20}\\b\\d+(?:\\.\\d+)?\\s*mg\\/dL\\b"
      }
    ]
  },
  "uncertaintyFloors": [
    {
      "scenarioId": "non_food_input",
      "minimumClassification": "None"
    },
    {
      "scenarioId": "ambiguous_food",
      "minimumClassification": "MODERATE"
    },
    {
      "scenarioId": "carbs_only_meal",
      "minimumClassification": "MODERATE"
    },
    {
      "scenarioId": "upper_band_borderline",
      "minimumClassification": "MODERATE"
    },
    {
      "scenarioId": "sugary_drink_or_dessert",
      "minimumClassification": "HIGH"
    }
  ]
}
